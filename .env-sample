POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
GIN_MODE=debug # release for prod

PORT=8011

ADMIN_TOKEN=

# Payment receipts. Set S3_BUCKET in production; without it receipts are kept on
# the container's local disk (development only, lost when the container is rebuilt).
S3_BUCKET=
S3_REGION=
# S3_ENDPOINT=   # only for S3-compatible storage such as Cloudflare R2 or MinIO
# S3_PREFIX=receipts/
# Default days reviewed receipt files are kept before the weekly cleanup deletes them
# (records are kept). The super admin can change it in the app.
RECEIPT_RETENTION_DAYS=90
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
